                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            MEASURES   is a 2 dimensional array which looks like:                            BELL | METER                                      (hi) TOTALED:      |       ( total of tempurature measures)     (lo)        :      |       ( ...at 2 second intervals.)                  OLD:      |       ( previous tempurature measure)        openFACTOR:      |       ( open rate correction factor)        checkFACTOR:      |       ( check rate correction factor)              FOOT:      |       ( volume in cubic feet)                    ACTUAL:      |       ( volume in actual encoder counts)                                                                PROBE   points to either the BELL or the METER array half.      BELL & METER   make PROBE point to their half of MEASURES array.TEMP   expects array index on stack, leaves address.            VOLUME   same as TEMP, used for clarity.                        0MEASURES   zeros out array except correction factors.                                                                          A/D@   fetches channel i from A/D converter.                    RANKIN   converts raw a/d output to rankin (absolute farenheit).FACTOR   multiplies in a tempurature correction factor to          compensate for slow response to tempurature changes.         ADJUST   get A/D channel i, convert to degrees Rankin, adjust      for tempurature change correction, add corrected tempurature    into total                                                   CALC   fetch and ADJUST both the meter & bell tempuratures.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     NORM ( d d - n n)   produces the 16 most significant bits          of the 2 double numbers on the stack, while maintaining an      equal proportion between the 2 numbers. NOTE! this version      is not a general use implementation since it assumes that       only 24 bits can be significant to start with.               %CORRECTION ( n)   this is the final result of the meter test.     A positive number indicates a fast meter, a negative number     indicates a slow meter.                                      FLOWRATE ( n)   calculates the rate of air flow through the        meter, during the middle half of the test.                                                                                                                                                                                                                                                                                                                                                                                                                   VALVES!   store the 5 bit value n to the valves such that a 1      always closes a valve, and a 0 always opens a valve.            bit 4 is operate valve,    bit 3 is bypass valve,               bit 2 is fill valve,       bit 1 is open rate valve, &          bit 0 is check rate valve.                                                                                                      the names of valves states reflect the state of each valve.     a 'C' indicates a closed valve, 'O' indicates an open valve.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 1WAKE ( a)   setup variable `a` to allow task to wake up from      interrupt code.                                              ?FULL   continue only if bell is not full.                      UP   1A=11010:  close oper, bypass, & openrate; open fill, &       check rate valves; then sleep until bell high is reached.    EXCERSIZE   excersize the meter, while filling bell if needed.  LOG   log the results of the last test, ready for xfer to host. NEW   set up all variables for new meter.                       NEXTMETER   do all things needed to start testing another meter.LEAK   0F=01111: open oper; close bypass, fill, open, & check.     abort" does an automatic FILL.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               This block handles the IRQ interrupts.                          SPURS  is a table consisting of a list of control ports            followed by a list of interrupt processing routines.         The  IRQ  interrupt checks the status register to determine        which device is the source of the interrupt, and then           branches to the appropriate routine.                         IRQ  is used to initialize the  SPURS  table.                      a = address of interrupt routine                                p = status port address                                         n = position in the  SPURS  table                            /INT  enables interrupts for the processor.                     |2@|  and |2!|  are used to fetch and store a double               precision variable with interrupts disabled.                 NOTE:  The  SPURS  table is always searched from the beginning.    So, assigning an interrupt to the first position gives it       priority over the other interrupts.                          VIA   is the address of the VIA board.                          INPUTS   stores the bell hi, bell low, encoder A, encoder B and    photo sensor inputs.                                         OLD-INPUTS   stores the 2nd most recent version of these inputs.ENCODER   stores the Number of encoder pulses from bell hi.        Bell hi is 0, bell low is 20,000.                            TICKS   stores the number of clock ticks.                       REMAINING   stores the number of seconds remaining in a test.   TA1   is the count-down value for via A, timer 1.               TA2   is the count-down value for via A, timer 2.               TB1   is the count-down value for via B, timer 1.               TB2   is the count-down value for via B, timer 2.               +INT   is the word that initializes the VIA-02 board and the       A/D converter board.                                                                                                                                                                                                                                         EDGES   tells me which edges to expect for the next interrupt,     based on what the encoder inputs are now.                                                                                    ADDER   tells me what to add to the encoder count based on what    the encoder inputs were lsat, and what they are now. A 180 is   assumed to be a rising bell. A 180 should never happen.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      This block is the IRQ interrupt handler.                        The contents of the VIA data ports are sampled and saved.       The VIA is setup to catch the next edge transition.             The direction of motion is derived and is applied to  ENCODER .    The value of  ENCODER  is also kept in  W  for further use.  If the bell has reached the top and is still filling the fill      valve is closed and the current encoder count is saved.      If the valve has reached the bottom the valves are set to fill     the bell and the current encoder count is saved.             If the operate valve is open and the bell is one quarter of the       way through the test a TTL pulse is sent, the countdown         timer is set and the time is saved.                          Otherwise, if the operate valve is open and the bell is three      quarters of the way through the test a TTL pulse is sent,       the countdown timer is set and the time is saved.                                                                         This block continues the interrupt handler.                     A needle edge is noted by examining the old and new VIA samples.   If a needle edge is detected the current sample tells the          direction of the edge; either rising or falling.          The new VIA input sample is copied in place of the old.         If another sample of the VIA shows any change we go back again. If a 10 ms timer interrupt has occurred the associated interrupt   flag is explicitly turned off, the double variable  TICKS  is   incremented and if the countdown timer is running it is         decremented.  When the countdown timer reachs zero the TTL      pulse is shut off and the timer will remain zero.            This interrupt handler is common to all of the sources of          interrupt.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   #REVS  first byte counts number of remaining edges in test.        If zero then next byte is copied to it and cleared.          'WATCHER  points to the task awakened by the edge interrupt.    TICKS  is a 32 bit counter incrementing once each 2.5ms.        TARG  is set to the ticks time of an enabled needle edge by the    VIA interrupt code.  TARG  and  TARG 2+  are set to this time   plus 1 sec in  INTERVAL  until the closing edge.  After this    "1sec" TARG 2@ - -  gives the time for the last interval.    VIA  gives the base address for the VIA-02 board.               <VIA>  for the clock interrupt; increments  TICKS  and if  #REVS   is set, awakens  'WATCHER  at the next  TARG  time.  For the    edge interrupt there are four cases; wait for one edge, start   a test, continue a test, end a test.  The values in  #REVS      and  #REVS 1+  for these cases are (in order);  both zero,      zero and revs, revs and zero, one and zero.  Continue and       start don't disable edges and continue doesn't waken a task.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 These routines provide convenient control and access to            the system clock, which ticks once every second.                                                                             T/MS  returns a pair of numbers representing ticks per             millisecond.                                                 T/SEC  returns a number representing the number of ticks           per second.                                                  T/DAY  returns a double number representing the number of          ticks per day.                                               MS  pauses for n milliseconds.                                  SECONDS   pauses for n seconds.                                                                                                 COUNTER (in the program)  and  TIMER  are used like this:          COUNTER  process-to-be-timed  TIMER ( return) #ms                                                                                                                                            HOURS   given the time in HH:MM:SS format, sets  TICKS             appropriately.  Interrupts are disabled when  TICKS  are        updated.                                                     @TIME  fetches the time of day from the specified address          Advances  TODAY  until the time is less than the number of      ticks per day.                                               6#   converts the next two low-order digits for output,            the first one in base 10, the second one in base 6.          (TIME)   converts the double precision number to a string          specifying the time in the format HH:MM:SS, leaving the         address and the count of the string on the stack.            .TIME  displays the current time.                               .WHEN  displays the current date and time.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      LED! ( n n)   factored word for LED & -LED.                     LED ( n)   turn on led n, where n=0,1,2,or3.                    -LED ( n)   turn off led n, where n=0,1,2,or3.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  NUMBERS  is a table of ASCII key codes which may be entered        during numeric conversion                                                                                                    FUNCTIONS  is a table of ASCII key codes which indicate            a specific function to be executed. For example:                  INTEST , MAINT , NEXT ...                                                                                                  key  returns the next character entered                                                                                         PROMPT  displays a TERMIFLEX prompt string terminated by          a colon, left justified in the TERMIFLEX display                                                                                                                                                                                                                                                                                                                                              number  converts the number in the TERMIFLEX  display. Returns    true if the number was successfully converted and stored        or was unchanged ;  otherwise returns false and the address     of the variable.                                                                                                              .VALUE  displays the current variables value right justified      in the display                                                                                                                REFRESH - updates the current number being entered on              the  VISUAL  display.                                        DIGITS  awaits numeric input for the specified variable.         Uses  REFRESH  after each character entered on the              TERMIFLEX.                                                                                                                                                                                                                                                     ( C - XXX  B - ON/OFF  A - JOG  9 - LEAK  8 - NEXT  7 - SPECIAL   6 - OPTIONS  5 - MAINT  4 - OUTTEST  3 - INTEST                 2 - DON'T CARE  1 - START/STOP  0 - ENTER                           1 is enabled, 0 is disabled )                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             +KEY  a defining word used to create words which enable               individual keys                                           -KEY  a defining word used to create words which disable              individual keys                                           LOCK  a defining word used to create words which lock              into a specific mode. (  INTEST ,  OUTTEST  , LEAK  )                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            