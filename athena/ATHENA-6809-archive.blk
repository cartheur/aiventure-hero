                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            >MENU   is used to save the current menu list address and          the number of screens in the list                                                                                            #MENU   is used to contain the current index to a menu list.                                                                    >INTEST , >OUTTEST , >MAINT  and  >OPTIONS  are menu lists         consisting of a count of the number of menus and the            addresses of the menus.                                                                                                      NULLIFY  marks all input variables invalid for the specified       menu                                                                                                                         iSCREENS   initializes intest and outtest menu input variables     to invalid.                                                                                                                                                                                  TESTS  is an array of the different tests run on the sonic         provers.                                                     WORK  activates the  TESTER  task to run a test according to       the current mode.                                            START/STOP  stops a test if one is currently running, otherwise    starts a test.                                               iSTAT  initializes status variables at startup                  STARTUP   initializes screen variables and status variables and    then displays the logon screen.                              ON/OFF   turns OFF the ON/OFF led and displays the logon screen.                                                                                                                                                                                                                                                                                                                                                                                                MENU   enables the NEXT key, sets the current group of menus to  the given list address, and displays the first menu in the list!MODE   sets the given mode and enables the  START  button.     INTEST/ OUTTEST  sets the mode to intest/outtest mode and        intest/outtest screens                                         MAINT  displays the maintenance screens and if no tests are        running, sets the mode to maintenance.                       OPTIONS  displays the options screen                            FOLLOW  displays the next menu in the current group of menus    LEAK  sets the mode to leak mode and displays the leak report   ENTER  executes the current function assigned to 'ENTER            ( processes the  ENTER  key )                                JOG  toggles between jogging state and bypass state.                 jogging - allowing air to flow thru the meter at the check         flow rate.                                                   bypass - no air flows thru the meter                       The  ACTIONS  array specifies the action to be taken               when a given function key is entered at the Termiflex.                                                                       MONITOR  monitors the Termiflex input and executes the             the appropriate action as specified in the  ACTIONS  array.                                                                  RETURN  is executed when an illegal entry is made.  'RETURN        contains an assigned behavior and a parameter.                                                                                                                                                                                                                                                                               .MENU  displays the given menu and places it in input mode      TITLE  displays the title for the given screen                                                                                                                                                  Blocks 256 - 257 are used to initialize maintenance variables      during resident testing.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     +TASKS   builds the Prover system tasks.                                                                                        START   initializes I/O, variables, activates the  SCANNER         task, displays the logon screen, and monitors the operator      inputs.                                                                                                                      POWER-UP  makes  VISUAL  the current task and executes  START ,    the start-up code.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               